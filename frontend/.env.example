# Google Sheets (read-only, public API key)
VITE_SHEET_ID=your_spreadsheet_id
VITE_SHEETS_API_KEY=your_google_api_key
VITE_SHEET_TAB=Tasks
VITE_MEETINGS_TAB=Meetings

# Go save server. Leave unset to stay on demo/local data only.
VITE_API_URL=http://localhost:8080

# Google OAuth "Web application" client ID. Must be the same value as the
# backend's GOOGLE_CLIENT_ID, and the site's origin must be listed under
# "Authorized JavaScript origins" for this client.
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
